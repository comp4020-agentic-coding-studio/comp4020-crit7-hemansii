---
// Shared shell for every page: head boilerplate, header/nav, footer. Pages
// bring their own <h1> and content through the default slot — this only
// exists to keep markup (and therefore the look) consistent across pages.
import "../styles.css";

export interface Props {
  title: string;
  active?: "rooms" | "bookings" | "readme";
}

const { title, active } = Astro.props;

const links: { href: string; label: string; key: "rooms" | "bookings" | "readme" }[] = [
  { href: "/", label: "Rooms", key: "rooms" },
  { href: "/bookings", label: "My bookings", key: "bookings" },
  { href: "/readme/", label: "About", key: "readme" },
];
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet"
    />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="site">
        <a href="/" class="brand">
          <span class="brand-mark" aria-hidden="true">◆</span>
          ANU Library Rooms
        </a>
        <ul class="nav-links">
          {
            links.map((link) => (
              <li>
                <a href={link.href} aria-current={link.key === active ? "page" : undefined}>
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <p>Study-room booking prototype for COMP4020 — not an official ANU service.</p>
    </footer>
  </body>
</html>
