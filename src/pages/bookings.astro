---
import Layout from "../layouts/Layout.astro";
import { getSessionUser } from "../lib/auth";
import { listUpcomingBookingsForUser } from "../lib/db";

const user = getSessionUser(Astro.cookies);
if (!user) return Astro.redirect("/login?next=/bookings", 303);

const today = new Date().toISOString().slice(0, 10);
const upcoming = listUpcomingBookingsForUser(user.id, today);
---

<Layout title="My bookings" active="bookings">
  <h1>My bookings</h1>
  <p class="account-line">
    Signed in as {user.email}.
    <form method="post" action="/api/logout" class="inline-form">
      <button class="btn-secondary">Log out</button>
    </form>
  </p>

  {
    upcoming.length === 0 ? (
      <p class="empty-state">No upcoming bookings — browse rooms to book a slot.</p>
    ) : (
      <ul id="upcoming-bookings">
        {upcoming.map((b) => (
          <li>
            <span>
              <strong>{b.roomName}</strong> · {b.date}, {b.startTime}–{b.endTime}
            </span>
            <form method="post" action="/api/bookings/cancel" class="inline-form">
              <input type="hidden" name="id" value={b.id} />
              <button class="btn-secondary">Cancel</button>
            </form>
          </li>
        ))}
      </ul>
    )
  }
</Layout>
