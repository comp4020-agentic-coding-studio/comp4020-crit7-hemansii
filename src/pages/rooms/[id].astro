---
import Layout from "../../layouts/Layout.astro";
import { getSessionUser } from "../../lib/auth";
import { CLOSING_TIME, ERROR_MESSAGES, OPENING_TIME, type BookingRejection } from "../../lib/bookings";
import { getRoom, listBookingsForRoomOnDate } from "../../lib/db";

const id = Number(Astro.params.id);
const room = getRoom(id);
if (!room) return Astro.redirect("/", 303);

const toISODate = (d: Date) => d.toISOString().slice(0, 10);
const today = new Date();
const date = Astro.url.searchParams.get("date") || toISODate(today);
const error = Astro.url.searchParams.get("error") as BookingRejection | null;

// Each nav entry carries its own weekday/day/month labels, computed from the
// same Date object used to derive the ISO string, rather than re-parsing the
// ISO date later — re-parsing a date-only string constructs a UTC midnight
// Date, which can read back as the wrong local day.
const dates = Array.from({ length: 14 }, (_, i) => {
  const d = new Date(today);
  d.setDate(d.getDate() + i);
  return {
    iso: toISODate(d),
    weekday: d.toLocaleDateString("en-AU", { weekday: "short" }),
    day: d.getDate(),
    month: d.toLocaleDateString("en-AU", { month: "short" }),
  };
});

const rawSchedule = listBookingsForRoomOnDate(id, date);
const user = getSessionUser(Astro.cookies);

// Timetable geometry: every time is placed as a percentage down the
// OPENING_TIME–CLOSING_TIME span, so the markup only needs top/height and
// never a fixed row grid to keep in sync with the business rules' hours.
const toMinutes = (time: string): number => {
  const [h, m] = time.split(":").map(Number);
  return h * 60 + m;
};
const dayStart = toMinutes(OPENING_TIME);
const dayEnd = toMinutes(CLOSING_TIME);
const daySpan = dayEnd - dayStart;

const hourMarks = Array.from({ length: dayEnd / 60 - dayStart / 60 + 1 }, (_, i) => {
  const hour = dayStart / 60 + i;
  return {
    label: `${String(hour).padStart(2, "0")}:00`,
    top: ((hour * 60 - dayStart) / daySpan) * 100,
  };
});

const schedule = rawSchedule.map((b) => ({
  ...b,
  top: ((toMinutes(b.startTime) - dayStart) / daySpan) * 100,
  height: ((toMinutes(b.endTime) - toMinutes(b.startTime)) / daySpan) * 100,
}));

// Half-hour options for the booking dialog's start/end pickers — plain
// <select>s read the same everywhere, unlike a native time input's
// browser-specific spinner UI.
const timeOptions = Array.from({ length: daySpan / 30 + 1 }, (_, i) => {
  const minutes = dayStart + i * 30;
  return `${String(Math.floor(minutes / 60)).padStart(2, "0")}:${String(minutes % 60).padStart(2, "0")}`;
});
---

<Layout title={room.name} active="rooms">
  <h1>{room.name}</h1>
  <p class="lede">
    Seats {room.capacity}
    {room.equipment ? ` · ${room.equipment.split(",").join(", ")}` : ""}
  </p>

  <div class="section">
    <h2>Choose a date</h2>
    <nav aria-label="date">
      <ul id="date-nav">
        {
          dates.map((d) => (
            <li>
              <a
                class="date-pill"
                href={`/rooms/${id}/?date=${d.iso}`}
                aria-current={d.iso === date ? "date" : undefined}
              >
                <span class="date-pill-dow">{d.iso === toISODate(today) ? "Today" : d.weekday}</span>
                <span class="date-pill-day">{d.day}</span>
                <span class="date-pill-month">{d.month}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="section">
    <div class="section-header">
      <h2>Schedule for {date}</h2>
      {
        user ? (
          <button type="button" class="btn-primary" data-open-dialog="booking-dialog">
            Make booking
          </button>
        ) : (
          <a class="btn-primary" href={`/login?next=${encodeURIComponent(`/rooms/${id}/?date=${date}`)}`}>
            Log in to book
          </a>
        )
      }
    </div>
    <div class="timetable" role="group" aria-label={`Booking schedule for ${date}, ${OPENING_TIME} to ${CLOSING_TIME}`}>
      <div class="timetable-hours" aria-hidden="true">
        {
          hourMarks.map((h) => (
            <span class="timetable-hour" style={`top:${h.top}%`}>
              {h.label}
            </span>
          ))
        }
      </div>
      <div class="timetable-body">
        <div class="timetable-gridlines" aria-hidden="true">
          {hourMarks.map((h) => <div class="timetable-gridline" style={`top:${h.top}%`} />)}
        </div>
        <ol class="timetable-track">
          {
            schedule.map((b) => (
              <li class="timetable-slot" data-tone={String(b.id % 5)} style={`top:${b.top}%;height:${b.height}%`}>
                <span class="timetable-slot-time">
                  {b.startTime}–{b.endTime}
                </span>
                <span class="timetable-slot-label">Booked</span>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
    {schedule.length === 0 && <p class="timetable-note">Free all day — nothing booked yet.</p>}
  </div>

  {
    user && (
      <dialog id="booking-dialog" class="booking-dialog" aria-labelledby="booking-dialog-title">
        <div class="booking-dialog-header">
          <h2 id="booking-dialog-title">Book {room.name}</h2>
          <button type="button" class="dialog-close" aria-label="Close" data-close-dialog>
            ×
          </button>
        </div>
        <p class="booking-dialog-sub">
          {date} · {OPENING_TIME}–{CLOSING_TIME}
        </p>
        <form method="post" action="/api/bookings/create" class="booking-form">
          {error && <p role="alert">{ERROR_MESSAGES[error]}</p>}
          <input type="hidden" name="roomId" value={id} />
          <input type="hidden" name="date" value={date} />
          <div class="field-row">
            <div class="field">
              <label for="startTime">Start</label>
              <select id="startTime" name="startTime" required>
                <option value="" disabled selected>
                  Select time
                </option>
                {
                  timeOptions.slice(0, -1).map((t) => (
                    <option value={t}>{t}</option>
                  ))
                }
              </select>
            </div>
            <div class="field">
              <label for="endTime">End</label>
              <select id="endTime" name="endTime" required>
                <option value="" disabled selected>
                  Select time
                </option>
                {
                  timeOptions.slice(1).map((t) => (
                    <option value={t}>{t}</option>
                  ))
                }
              </select>
            </div>
          </div>
          <div class="booking-dialog-actions">
            <button type="button" class="btn-secondary" data-close-dialog>
              Cancel
            </button>
            <button type="submit" class="btn-primary">
              Confirm booking
            </button>
          </div>
        </form>
      </dialog>
    )
  }

  <script define:vars={{ roomId: id, date, autoOpenBooking: Boolean(error) }}>
    // One global SSE stream carries every room's bookings (see
    // src/lib/events.ts); this page only cares about its own room+date, so
    // it filters client-side rather than the server needing a per-room
    // stream.
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const booking = JSON.parse(event.data);
      if (booking.roomId === roomId && booking.date === date) {
        location.reload();
      }
    });

    const dialog = document.getElementById("booking-dialog");
    for (const opener of document.querySelectorAll("[data-open-dialog]")) {
      opener.addEventListener("click", () => dialog?.showModal());
    }
    for (const closer of document.querySelectorAll("[data-close-dialog]")) {
      closer.addEventListener("click", () => dialog?.close());
    }
    if (autoOpenBooking) dialog?.showModal();
  </script>
</Layout>
