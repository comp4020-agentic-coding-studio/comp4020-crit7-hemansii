---
import Layout from "../../layouts/Layout.astro";
import { getSessionUser } from "../../lib/auth";
import { CLOSING_TIME, ERROR_MESSAGES, OPENING_TIME, type BookingRejection } from "../../lib/bookings";
import { getRoom, listBookingsForRoomOnDate } from "../../lib/db";

const id = Number(Astro.params.id);
const room = getRoom(id);
if (!room) return Astro.redirect("/", 303);

const toISODate = (d: Date) => d.toISOString().slice(0, 10);
const today = new Date();
const date = Astro.url.searchParams.get("date") || toISODate(today);
const error = Astro.url.searchParams.get("error") as BookingRejection | null;

const dates = Array.from({ length: 14 }, (_, i) => {
  const d = new Date(today);
  d.setDate(d.getDate() + i);
  return toISODate(d);
});

const schedule = listBookingsForRoomOnDate(id, date);
const user = getSessionUser(Astro.cookies);
---

<Layout title={room.name} active="rooms">
  <h1>{room.name}</h1>
  <p class="lede">
    Seats {room.capacity}
    {room.equipment ? ` · ${room.equipment.split(",").join(", ")}` : ""}
  </p>

  <div class="section">
    <h2>Choose a date</h2>
    <nav aria-label="date">
      <ul id="date-nav">
        {
          dates.map((d) => (
            <li>
              <a href={`/rooms/${id}/?date=${d}`} aria-current={d === date ? "date" : undefined}>
                {d === toISODate(today) ? "Today" : d}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>

  <div class="section">
    <h2>Schedule for {date}</h2>
    {error && <p role="alert">{ERROR_MESSAGES[error]}</p>}
    {
      schedule.length === 0 ? (
        <p class="empty-state">The room is free all day — nothing booked yet.</p>
      ) : (
        <ul id="schedule">
          {schedule.map((b) => (
            <li>
              <span>
                {b.startTime}–{b.endTime}
              </span>
              <span class="badge">Booked</span>
            </li>
          ))}
        </ul>
      )
    }
  </div>

  <div class="section">
    {
      user ? (
        <>
          <h2>Book this room</h2>
          <form method="post" action="/api/bookings/create" class="card">
            <input type="hidden" name="roomId" value={id} />
            <input type="hidden" name="date" value={date} />
            <div class="field">
              <label for="startTime">Start</label>
              <input
                id="startTime"
                name="startTime"
                type="time"
                required
                min={OPENING_TIME}
                max={CLOSING_TIME}
                step="1800"
              />
            </div>
            <div class="field">
              <label for="endTime">End</label>
              <input
                id="endTime"
                name="endTime"
                type="time"
                required
                min={OPENING_TIME}
                max={CLOSING_TIME}
                step="1800"
              />
            </div>
            <button>Book</button>
          </form>
        </>
      ) : (
        <p class="empty-state">
          <a href={`/login?next=${encodeURIComponent(`/rooms/${id}/?date=${date}`)}`}>Log in</a> to book this room.
        </p>
      )
    }
  </div>

  <script define:vars={{ roomId: id, date }}>
    // One global SSE stream carries every room's bookings (see
    // src/lib/events.ts); this page only cares about its own room+date, so
    // it filters client-side rather than the server needing a per-room
    // stream.
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const booking = JSON.parse(event.data);
      if (booking.roomId === roomId && booking.date === date) {
        location.reload();
      }
    });
  </script>
</Layout>
