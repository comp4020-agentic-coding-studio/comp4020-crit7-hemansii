---
import DateNav from "../../components/DateNav.astro";
import Layout from "../../layouts/Layout.astro";
import {
  CLOSING_MINUTES,
  OPENING_MINUTES,
  SLOT_MINUTES,
  formatDuration,
  freeGaps,
  libraryNow,
  liveBookings,
  quotaUsed,
  roomAvailability,
  toMinutes,
  toTime,
} from "../../lib/availability";
import { getSessionUser } from "../../lib/auth";
import {
  CLOSING_TIME,
  ERROR_MESSAGES,
  MAX_BOOKING_MINUTES,
  OPENING_TIME,
  type BookingRejection,
} from "../../lib/bookings";
import { getRoom, listBookingsForRoomOnDate, listBookingsForUserOnDate } from "../../lib/db";

const id = Number(Astro.params.id);
const room = getRoom(id);
if (!room) return Astro.redirect("/", 303);

const now = libraryNow();
const date = Astro.url.searchParams.get("date") || now.date;
const error = Astro.url.searchParams.get("error") as BookingRejection | null;
const requestedStart = Astro.url.searchParams.get("start");
const isToday = date === now.date;

const user = getSessionUser(Astro.cookies);

// Bookings nobody checked into have lapsed and no longer hold the room, so
// everything on this page — the timetable, the free gaps, the picker — is
// derived from the live set rather than every row in the table.
const booked = liveBookings(listBookingsForRoomOnDate(id, date), now.date, now.minutes);

const bookableFrom = isToday
  ? Math.ceil(Math.max(now.minutes, OPENING_MINUTES) / SLOT_MINUTES) * SLOT_MINUTES
  : OPENING_MINUTES;
const gaps = freeGaps(booked, bookableFrom);
const span = CLOSING_MINUTES - OPENING_MINUTES;
const percent = (minutes: number) => ((minutes - OPENING_MINUTES) / span) * 100;

const hourMarks = Array.from({ length: CLOSING_MINUTES / 60 - OPENING_MINUTES / 60 + 1 }, (_, i) => {
  const hour = OPENING_MINUTES / 60 + i;
  return { label: `${String(hour).padStart(2, "0")}:00`, top: percent(hour * 60) };
});

const schedule = booked.map((booking) => ({
  ...booking,
  top: percent(toMinutes(booking.startTime)),
  height: ((toMinutes(booking.endTime) - toMinutes(booking.startTime)) / span) * 100,
}));

const openSlots = gaps.map((gap) => ({
  ...gap,
  top: percent(toMinutes(gap.startTime)),
  height: ((toMinutes(gap.endTime) - toMinutes(gap.startTime)) / span) * 100,
  minutes: toMinutes(gap.endTime) - toMinutes(gap.startTime),
}));

const availability = roomAvailability(booked, now.minutes);

// Every half hour that could start a booking: inside a free stretch, with at
// least one bookable slot after it.
const startTimes = gaps.flatMap((gap) => {
  const from = toMinutes(gap.startTime);
  const to = toMinutes(gap.endTime);
  return Array.from({ length: (to - from) / SLOT_MINUTES }, (_, i) => toTime(from + i * SLOT_MINUTES));
});
const endTimes = Array.from(
  { length: (CLOSING_MINUTES - OPENING_MINUTES) / SLOT_MINUTES },
  (_, i) => toTime(OPENING_MINUTES + (i + 1) * SLOT_MINUTES),
);

const quota = user
  ? quotaUsed(liveBookings(listBookingsForUserOnDate(user.id, date), now.date, now.minutes))
  : null;
const canBook = Boolean(user) && startTimes.length > 0 && (quota?.remainingMinutes ?? 0) > 0;
const prefill = requestedStart && startTimes.includes(requestedStart) ? requestedStart : "";
---

<Layout title={room.name} active="rooms">
  <a class="backlink" href="/">← All rooms</a>
  <h1>{room.name}</h1>
  <p class="lede">
    Seats {room.capacity}
    {room.equipment ? ` · ${room.equipment.split(",").join(", ")}` : ""}
  </p>
  <p class="status-line">
    <span class="status-pill" data-state={availability.state}>
      <span class="status-dot" aria-hidden="true"></span>
      {availability.state === "free" ? "Free" : availability.state === "busy" ? "Busy" : "Closed"}
    </span>
    <span>{availability.label}</span>
  </p>

  <div class="section">
    <h2>Choose a date</h2>
    <DateNav basePath={`/rooms/${id}/`} date={date} today={now.date} />
  </div>

  <div class="section">
    <div class="section-header">
      <h2>{isToday ? "Today's schedule" : `Schedule for ${date}`}</h2>
      {
        user ? (
          <button type="button" class="btn-primary" data-open-dialog disabled={!canBook}>
            Make booking
          </button>
        ) : (
          <a class="btn-primary" href={`/login?next=${encodeURIComponent(`/rooms/${id}/?date=${date}`)}`}>
            Log in to book
          </a>
        )
      }
    </div>

    {
      quota && quota.remainingMinutes === 0 && (
        <p class="notice" role="status">
          You've used your {formatDuration(quota.usedMinutes)} for {date}. Cancel a booking or pick
          another day.
        </p>
      )
    }
    {
      user && quota && quota.remainingMinutes > 0 && quota.usedMinutes > 0 && (
        <p class="notice" role="status">
          {formatDuration(quota.remainingMinutes)} of your daily 2 hours left for {date}.
        </p>
      )
    }

    <div
      class="timetable"
      role="group"
      aria-label={`Booking schedule for ${date}, ${OPENING_TIME} to ${CLOSING_TIME}`}
    >
      <div class="timetable-hours" aria-hidden="true">
        {
          hourMarks.map((h) => (
            <span class="timetable-hour" style={`top:${h.top}%`}>
              {h.label}
            </span>
          ))
        }
      </div>
      <div class="timetable-body">
        <div class="timetable-gridlines" aria-hidden="true">
          {hourMarks.map((h) => <div class="timetable-gridline" style={`top:${h.top}%`} />)}
        </div>
        <div class="timetable-track">
          {
            openSlots.map((slot) =>
              canBook ? (
                <button
                  type="button"
                  class="timetable-open"
                  style={`top:${slot.top}%;height:${slot.height}%`}
                  data-start={slot.startTime}
                  data-end={slot.endTime}
                >
                  <span class="timetable-open-label">
                    Free {slot.startTime}–{slot.endTime}
                  </span>
                  <span class="timetable-open-cta" aria-hidden="true">
                    Book this
                  </span>
                </button>
              ) : (
                <span class="timetable-open is-static" style={`top:${slot.top}%;height:${slot.height}%`}>
                  <span class="timetable-open-label">
                    Free {slot.startTime}–{slot.endTime}
                  </span>
                </span>
              ),
            )
          }
          <ol class="timetable-bookings">
            {
              schedule.map((b) => (
                <li
                  class="timetable-slot"
                  data-tone={String(b.id % 5)}
                  style={`top:${b.top}%;height:${b.height}%`}
                >
                  <span class="timetable-slot-time">
                    {b.startTime}–{b.endTime}
                  </span>
                  <span class="timetable-slot-label">Booked</span>
                </li>
              ))
            }
          </ol>
        </div>
      </div>
    </div>
    <p class="timetable-note">
      {
        schedule.length === 0
          ? "Nothing booked yet — the whole day is open."
          : `${schedule.length} ${schedule.length === 1 ? "booking" : "bookings"} on this day.`
      }
      {canBook && " Click any open stretch to book it."}
    </p>
  </div>

  {
    user && (
      <dialog id="booking-dialog" class="booking-dialog" aria-labelledby="booking-dialog-title">
        <div class="booking-dialog-header">
          <h2 id="booking-dialog-title">Book {room.name}</h2>
          <button type="button" class="dialog-close" aria-label="Close" data-close-dialog>
            ×
          </button>
        </div>
        <p class="booking-dialog-sub">
          {date} · up to {formatDuration(MAX_BOOKING_MINUTES)} per booking
        </p>
        <form method="post" action="/api/bookings/create" class="booking-form">
          {error && <p class="form-error" role="alert">{ERROR_MESSAGES[error]}</p>}
          <input type="hidden" name="roomId" value={id} />
          <input type="hidden" name="date" value={date} />
          <div class="field-row">
            <div class="field">
              <label for="startTime">Start</label>
              <select id="startTime" name="startTime" required>
                <option value="" disabled selected={!prefill}>
                  Select time
                </option>
                {
                  startTimes.map((t) => (
                    <option value={t} selected={t === prefill}>
                      {t}
                    </option>
                  ))
                }
              </select>
            </div>
            <div class="field">
              <label for="endTime">End</label>
              <select id="endTime" name="endTime" required>
                <option value="" disabled selected>
                  Select time
                </option>
                {
                  endTimes.map((t) => (
                    <option value={t}>{t}</option>
                  ))
                }
              </select>
            </div>
          </div>
          <p class="booking-duration" data-duration aria-live="polite"></p>
          <div class="booking-dialog-actions">
            <button type="button" class="btn-secondary" data-close-dialog>
              Cancel
            </button>
            <button type="submit" class="btn-primary">
              Confirm booking
            </button>
          </div>
        </form>
      </dialog>
    )
  }

  <script
    is:inline
    type="application/json"
    id="booking-config"
    set:html={JSON.stringify({
      roomId: id,
      date,
      gaps,
      maxMinutes: MAX_BOOKING_MINUTES,
      remainingMinutes: quota?.remainingMinutes ?? 0,
      autoOpen: Boolean(error) || Boolean(prefill),
    })}
  />

  <script>
    // Per-request data rides in the JSON tag above rather than through
    // define:vars, so this script stays a static bundle instead of being
    // re-inlined into every response.
    type Gap = { startTime: string; endTime: string };
    const config: {
      roomId: number;
      date: string;
      gaps: Gap[];
      maxMinutes: number;
      remainingMinutes: number;
      autoOpen: boolean;
    } = JSON.parse(document.getElementById("booking-config")?.textContent ?? "{}");
    const { roomId, date, gaps, maxMinutes, remainingMinutes, autoOpen } = config;

    // One global SSE stream carries every room's bookings (see
    // src/lib/events.ts); this page only cares about its own room+date, so
    // it filters client-side rather than the server needing a per-room stream.
    const source = new EventSource("/api/events");
    source.addEventListener("message", (event) => {
      const booking = JSON.parse(event.data);
      if (booking.roomId === roomId && booking.date === date) location.reload();
    });

    const dialog = document.querySelector<HTMLDialogElement>("#booking-dialog");
    const startSelect = document.querySelector<HTMLSelectElement>("#startTime");
    const endSelect = document.querySelector<HTMLSelectElement>("#endTime");
    const duration = document.querySelector<HTMLElement>("[data-duration]");

    const minutes = (time: string): number =>
      Number(time.slice(0, 2)) * 60 + Number(time.slice(3, 5));
    const label = (total: number): string => {
      const h = Math.floor(total / 60);
      const m = total % 60;
      return h && m ? `${h}h ${m}m` : h ? `${h}h` : `${m}m`;
    };

    function showDuration(): void {
      if (!duration) return;
      const start = startSelect?.value;
      const end = endSelect?.value;
      duration.textContent = start && end ? `${label(minutes(end) - minutes(start))} booking` : "";
    }

    // The end times a start actually allows: inside the same free stretch, and
    // no longer than a single booking — or than what's left of today's cap —
    // is allowed to run. Narrowing here means the picker can't offer a time
    // the server is only going to reject.
    function refreshEndOptions(): void {
      if (!startSelect || !endSelect) return;
      const start = startSelect.value;
      if (!start) return;

      const gap = gaps.find(
        (g) => minutes(g.startTime) <= minutes(start) && minutes(start) < minutes(g.endTime),
      );
      const ceiling = Math.min(
        gap ? minutes(gap.endTime) : minutes(start),
        minutes(start) + Math.min(maxMinutes, remainingMinutes || maxMinutes),
      );

      const previous = endSelect.value;
      for (const option of endSelect.options) {
        if (!option.value) continue;
        const value = minutes(option.value);
        option.hidden = option.disabled = value <= minutes(start) || value > ceiling;
      }

      const kept = [...endSelect.options].find((o) => o.value === previous && !o.disabled);
      if (!kept) {
        const first = [...endSelect.options].find((o) => o.value && !o.disabled);
        endSelect.value = first ? first.value : "";
      }
      showDuration();
    }

    startSelect?.addEventListener("change", refreshEndOptions);
    endSelect?.addEventListener("change", showDuration);

    const open = (start?: string): void => {
      if (!dialog) return;
      if (start && startSelect) startSelect.value = start;
      refreshEndOptions();
      dialog.showModal();
    };

    for (const button of document.querySelectorAll("[data-open-dialog]")) {
      button.addEventListener("click", () => open());
    }
    // Clicking a free stretch on the timetable books that stretch.
    for (const slot of document.querySelectorAll<HTMLElement>(".timetable-open[data-start]")) {
      slot.addEventListener("click", () => open(slot.dataset.start));
    }
    for (const button of document.querySelectorAll("[data-close-dialog]")) {
      button.addEventListener("click", () => dialog?.close());
    }
    if (autoOpen) open(startSelect?.value || undefined);
  </script>
</Layout>
