---
import Layout from "../layouts/Layout.astro";

const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next") || "/";
const messages: Record<string, string> = {
  "invalid-credentials": "Wrong email or password.",
};
---

<Layout title="Log in">
  <div class="card auth-card">
    <h1>Log in</h1>
    {error && <p role="alert">{messages[error] ?? "Something went wrong."}</p>}
    <form method="post" action="/api/login" class="auth-form">
      <input type="hidden" name="next" value={next} />
      <div class="field">
        <label for="email">Email</label>
        <input id="email" name="email" type="email" required />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input id="password" name="password" type="password" required />
      </div>
      <button>Log in</button>
    </form>
    <p class="auth-footnote">
      No account? <a href={`/signup?next=${encodeURIComponent(next)}`}>Sign up</a> with your @anu.edu.au email.
    </p>
  </div>
</Layout>
