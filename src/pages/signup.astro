---
import "../styles.css";

const error = Astro.url.searchParams.get("error");
const next = Astro.url.searchParams.get("next") || "/";
const messages: Record<string, string> = {
  "not-anu-email": "You need an @anu.edu.au email to sign up.",
  "weak-password": "Password must be at least 8 characters.",
  "email-taken": "An account with that email already exists.",
};
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign up</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="site-nav" aria-label="site">
        <span class="brand">ANU Library Rooms</span>
        <a href="/">Rooms</a>
        <a href="/bookings">My bookings</a>
        <a href="/readme/">About</a>
      </nav>
    </header>
    <main>
      <div class="card auth-card">
        <h1>Sign up</h1>
        <p>Booking a room needs an ANU account — this proves you're a student, not just someone typing an email.</p>
        {error && <p role="alert">{messages[error] ?? "Something went wrong."}</p>}
        <form method="post" action="/api/signup" class="auth-form">
          <input type="hidden" name="next" value={next} />
          <div>
            <label for="email">ANU email</label>
            <input id="email" name="email" type="email" required placeholder="u1234567@anu.edu.au" />
          </div>
          <div>
            <label for="password">Password</label>
            <input id="password" name="password" type="password" required minlength="8" />
          </div>
          <button>Sign up</button>
        </form>
        <p>Already have an account? <a href={`/login?next=${encodeURIComponent(next)}`}>Log in</a>.</p>
      </div>
    </main>
  </body>
</html>
