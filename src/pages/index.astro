---
import { listRooms } from "../lib/db";
import "../styles.css";

const rooms = listRooms();
---

<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Study rooms</title>
  </head>
  <body>
    <nav aria-label="site">
      <a href="/">Rooms</a>
      <a href="/bookings">My bookings</a>
      <a href="/readme/">About</a>
    </nav>
    <main>
      <h1>Study rooms</h1>
      <p>Pick a room to see today's schedule and book a slot.</p>
      <ul id="rooms">
        {
          rooms.map((room) => (
            <li>
              <a href={`/rooms/${room.id}/`}>{room.name}</a> — seats {room.capacity}
              {room.equipment ? `, ${room.equipment.split(",").join(", ")}` : ""}
            </li>
          ))
        }
      </ul>
    </main>
  </body>
</html>
