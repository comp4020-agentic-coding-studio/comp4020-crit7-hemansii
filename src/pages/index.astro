---
import Layout from "../layouts/Layout.astro";
import { listRooms } from "../lib/db";

const rooms = listRooms();
---

<Layout title="Study rooms" active="rooms">
  <h1>Study rooms</h1>
  <p class="lede">Pick a room to see today's schedule and book a slot.</p>

  <ul id="rooms">
    {
      rooms.map((room) => (
        <li>
          <a href={`/rooms/${room.id}/`}>{room.name}</a>
          <span class="room-meta">Seats {room.capacity}</span>
          {room.equipment && (
            <ul class="badge-list">
              {room.equipment.split(",").map((item) => (
                <li class="badge">{item}</li>
              ))}
            </ul>
          )}
        </li>
      ))
    }
  </ul>
</Layout>
