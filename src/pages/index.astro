---
import Layout from "../layouts/Layout.astro";
import { listRooms } from "../lib/db";

const rooms = listRooms();
---

<Layout title="Study rooms" active="rooms">
  <h1>Study rooms</h1>
  <p class="lede">Pick a room to see today's schedule and book a slot.</p>

  <ul id="rooms">
    {
      rooms.map((room) => (
        <li>
          <a class="room-card" href={`/rooms/${room.id}/`}>
            <span class="room-name">{room.name}</span>
            <span class="room-meta">
              {room.capacity} {room.capacity === 1 ? "seat" : "seats"}
              {room.equipment && ` · ${room.equipment.split(",").join(", ")}`}
            </span>
          </a>
        </li>
      ))
    }
  </ul>
</Layout>
